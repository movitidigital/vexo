<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="supabase-client.js"></script>
<style>
  .ro-wrap { font-family: 'Poppins', sans-serif; color: #0f172a; padding: 4px; }
  .ro-filters {
    background: white; border-radius: 14px; padding: 20px 22px;
    border: 1px solid #e2e8f0; margin-bottom: 22px;
    display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end;
  }
  .ro-field { display: flex; flex-direction: column; gap: 5px; min-width: 140px; }
  .ro-field label { font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
  .ro-field input, .ro-field select {
    padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 9px;
    font-family: inherit; font-size: 13px; outline: none; transition: 0.2s;
    background: white;
  }
  .ro-field input:focus, .ro-field select:focus { border-color: #0b1a3a; box-shadow: 0 0 0 3px rgba(11,26,58,0.08); }
  .ro-btn { padding: 10px 20px; border-radius: 10px; font-family: inherit; font-weight: 700; font-size: 13px; cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; }
  .ro-btn-primary { background: #0b1a3a; color: white; }
  .ro-btn-primary:hover:not(:disabled) { background: #1a3060; }
  .ro-btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
  .ro-btn-soft { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
  .ro-btn-soft:hover { background: #e2e8f0; }
  .ro-btn-pdf { background: #dc2626; color: white; }
  .ro-btn-pdf:hover:not(:disabled) { background: #b91c1c; }
  .ro-btn-xls { background: #16a34a; color: white; }
  .ro-btn-xls:hover:not(:disabled) { background: #15803d; }
  .ro-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .ro-kpis {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px; margin-bottom: 22px;
  }
  .ro-kpi {
    background: white; border-radius: 14px; padding: 16px 18px;
    border: 1px solid #e2e8f0; position: relative;
  }
  .ro-kpi::before { content: ''; position: absolute; top: 0; left: 0; height: 3px; width: 100%; border-radius: 14px 14px 0 0; background: var(--c, #0b1a3a); }
  .ro-kpi-label { font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
  .ro-kpi-value { font-size: 22px; font-weight: 800; color: #0f172a; margin-top: 4px; }
  .ro-kpi-sub { font-size: 10px; color: #94a3b8; margin-top: 2px; }

  /* PAINEL DUPLO: gráfico rosca + top lista */
  .ro-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 22px;
  }
  @media (max-width: 900px) { .ro-row { grid-template-columns: 1fr; } }
  .ro-box {
    background: white; border-radius: 14px; border: 1px solid #e2e8f0;
    padding: 20px 24px;
  }
  .ro-box h3 { margin: 0 0 4px; font-size: 14px; font-weight: 800; color: #0b1a3a; }
  .ro-box p { margin: 0 0 16px; font-size: 11px; color: #64748b; }
  .ro-graf-inner { position: relative; height: 280px; }

  /* Ranking top inline */
  .ro-rank {
    display: flex; align-items: center; gap: 12px;
    padding: 10px 12px; border-radius: 10px; margin-bottom: 8px;
    background: #f8fafc; border-left: 4px solid var(--cor, #64748b);
  }
  .ro-rank-pos {
    width: 24px; height: 24px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 800; background: white; color: #475569;
    border: 1.5px solid #cbd5e1; flex-shrink: 0;
  }
  .ro-rank-pos.p1 { background: #fef3c7; color: #92400e; border-color: #fbbf24; }
  .ro-rank-pos.p2 { background: #e2e8f0; color: #475569; border-color: #cbd5e1; }
  .ro-rank-pos.p3 { background: #fed7aa; color: #9a3412; border-color: #d97706; }
  .ro-rank-nome { flex: 1; font-weight: 700; font-size: 13px; color: #0f172a; }
  .ro-rank-qtd { font-weight: 800; font-size: 14px; color: #0f172a; }
  .ro-rank-perc { font-size: 10px; color: #64748b; }

  /* TABELA */
  .ro-tabela { background: white; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 22px; }
  .ro-thead {
    padding: 14px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
  }
  .ro-thead h3 { margin: 0; font-size: 13px; font-weight: 800; color: #0b1a3a; }
  .ro-thead span { font-size: 11px; color: #64748b; }
  .ro-scroll { max-height: 500px; overflow-y: auto; }
  .ro-tab { width: 100%; border-collapse: collapse; font-size: 12px; }
  .ro-tab th {
    text-align: left; padding: 10px 14px; background: #f8fafc;
    color: #475569; font-size: 10px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.5px;
    border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 2;
  }
  .ro-tab td { padding: 10px 14px; border-bottom: 1px solid #f1f5f9; }
  .ro-tab tr:hover td { background: #f8fafc; }
  .ro-tab td.r { text-align: right; font-weight: 700; }
  .ro-tab td.c { text-align: center; }

  /* Badge operadora */
  .ro-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 12px;
    font-size: 11px; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .ro-badge::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: currentColor;
  }
  .ro-badge.vivo    { background: #ede9fe; color: #6d28d9; }
  .ro-badge.claro   { background: #fee2e2; color: #b91c1c; }
  .ro-badge.oi      { background: #fef3c7; color: #b45309; }
  .ro-badge.tim     { background: #dbeafe; color: #1e40af; }
  .ro-badge.algar   { background: #dcfce7; color: #166534; }
  .ro-badge.sercom  { background: #fce7f3; color: #9d174d; }
  .ro-badge.outras  { background: #f1f5f9; color: #475569; }
  .ro-badge.nao_informada { background: #f8fafc; color: #94a3b8; border: 1px dashed #cbd5e1; }

  .ro-badge-tipo {
    display: inline-block; padding: 3px 8px; border-radius: 10px;
    font-size: 10px; font-weight: 800; text-transform: uppercase;
  }
  .ro-badge-tipo.terceiro   { background: #dbeafe; color: #1e40af; }
  .ro-badge-tipo.freelancer { background: #fce7f3; color: #9d174d; }

  .ro-vazio { padding: 60px; text-align: center; color: #94a3b8; }

  /* MULTI-SELECT */
  .ro-multi { position: relative; min-width: 200px; }
  .ro-multi-trigger {
    display: flex; align-items: center; justify-content: space-between;
    padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 9px;
    background: white; cursor: pointer; font-size: 13px;
    font-family: inherit; min-height: 38px;
    transition: 0.2s; user-select: none;
  }
  .ro-multi-trigger:hover { border-color: #0b1a3a; }
  .ro-multi-trigger.aberto { border-color: #0b1a3a; box-shadow: 0 0 0 3px rgba(11,26,58,0.08); }
  .ro-multi-label { flex: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #0f172a; }
  .ro-multi-label.vazio { color: #94a3b8; }
  .ro-multi-seta { font-size: 10px; color: #64748b; margin-left: 8px; transition: transform 0.2s; }
  .ro-multi-trigger.aberto .ro-multi-seta { transform: rotate(180deg); }
  .ro-multi-painel {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0;
    background: white; border: 1.5px solid #cbd5e1; border-radius: 10px;
    box-shadow: 0 12px 28px -8px rgba(15,23,42,0.18);
    z-index: 100; display: none; max-height: 340px; overflow: hidden;
    flex-direction: column;
  }
  .ro-multi-painel.aberto { display: flex; }
  .ro-multi-busca { padding: 8px 12px; border-bottom: 1px solid #e2e8f0; }
  .ro-multi-busca input {
    width: 100%; padding: 7px 10px; border: 1px solid #e2e8f0;
    border-radius: 7px; font-size: 12px; outline: none; font-family: inherit;
    box-sizing: border-box;
  }
  .ro-multi-lista { overflow-y: auto; padding: 6px; flex: 1; }
  .ro-multi-opt {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 10px; border-radius: 6px; cursor: pointer;
    font-size: 12.5px; color: #334155; user-select: none;
    transition: background 0.15s;
  }
  .ro-multi-opt:hover { background: #f1f5f9; }
  .ro-multi-opt input { accent-color: #0b1a3a; width: 15px; height: 15px; cursor: pointer; flex-shrink: 0; }
  .ro-multi-opt.escondido { display: none; }
  .ro-multi-rodape {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 12px; border-top: 1px solid #e2e8f0; background: #f8fafc; gap: 8px;
  }
  .ro-multi-rodape button {
    padding: 6px 12px; border: none; border-radius: 7px;
    font-family: inherit; font-size: 11px; font-weight: 700;
    cursor: pointer; transition: 0.15s;
  }
  .ro-multi-limpar { background: #f1f5f9; color: #475569; }
  .ro-multi-aplicar { background: #0b1a3a; color: white; }
</style>

<div class="ro-wrap" id="ro-wrap">

  <!-- FILTROS -->
  <div class="ro-filters">
    <div class="ro-field">
      <label>Mês</label>
      <select id="ro-mes">
        <option value="1">Janeiro</option><option value="2">Fevereiro</option>
        <option value="3">Março</option><option value="4">Abril</option>
        <option value="5">Maio</option><option value="6">Junho</option>
        <option value="7">Julho</option><option value="8">Agosto</option>
        <option value="9">Setembro</option><option value="10">Outubro</option>
        <option value="11">Novembro</option><option value="12">Dezembro</option>
      </select>
    </div>
    <div class="ro-field">
      <label>Ano</label>
      <select id="ro-ano">
        <option value="2025">2025</option>
        <option value="2026" selected>2026</option>
        <option value="2027">2027</option>
      </select>
    </div>
    <div class="ro-field">
      <label>Início (opcional)</label>
      <input type="date" id="ro-ini">
    </div>
    <div class="ro-field">
      <label>Fim (opcional)</label>
      <input type="date" id="ro-fim">
    </div>
    <div class="ro-field">
      <label>Tipo TBP</label>
      <select id="ro-tipo">
        <option value="">Todos</option>
        <option value="TERCEIRO">Terceiros</option>
        <option value="FREELANCER">Freelancers</option>
      </select>
    </div>
    <div class="ro-field">
      <label>Operadoras</label>
      <div class="ro-multi" id="ro-multi-operadora" data-tipo="operadora">
        <div class="ro-multi-trigger" data-tipo="operadora">
          <span class="ro-multi-label vazio" id="ro-label-operadora">Todas</span>
          <span class="ro-multi-seta">▼</span>
        </div>
        <div class="ro-multi-painel" id="ro-painel-operadora">
          <div class="ro-multi-busca">
            <input type="text" placeholder="🔍 Buscar..." data-busca-tipo="operadora">
          </div>
          <div class="ro-multi-lista" id="ro-lista-operadora"></div>
